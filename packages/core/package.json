      "default": "./dist/parse.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/normalize.js",
      "default": "./dist/normalize.js"
    },
    "./alias": {
      "types": "./dist/alias.d.ts",
      "import": "./dist/alias.js",
      "default": "./dist/alias.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./confidence": {
      "types": "./dist/confidence.d.ts",
      "import": "./dist/confidence.js",
      "default": "./dist/confidence.js"
    },
    "./matching": {
      "types": "./dist/matching/index.d.ts",
      "import": "./dist/matching/index.js",
      "default": "./dist/matching/index.js"
    },
    "./matching/courseMatcher": {
      "types": "./dist/matching/courseMatcher.d.ts",
      "import": "./dist/matching/courseMatcher.js",
      "default": "./dist/matching/courseMatcher.js"
